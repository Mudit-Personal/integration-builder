{
  "name": "integration-builder",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "demo:packs": "node --no-warnings scripts/build-packs.ts",
    "demo:dev": "npm run demo:packs && vite --config web/vite.config.ts",
    "demo:build": "npm run demo:packs && npm run demo:api && vite build --config web/vite.config.ts",
    "demo:preview": "vite preview --config web/vite.config.ts --port 4320",
    "demo:api": "esbuild server/read.ts --bundle --platform=node --format=esm --target=node24 --outfile=api/read.mjs --log-level=warning \"--banner:js=import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "demo:read": "node --no-warnings scripts/read-dev.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@noble/hashes": "^2.4.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
