{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run demo:build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/read.mjs": {
      "maxDuration": 300
    },
    "api/app.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/((?!read$).*)",
      "destination": "/api/app"
    }
  ]
}
