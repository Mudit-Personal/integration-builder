#!/bin/sh
# Blocks a commit whose staged changes contain an API token or key.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so the secret scan can't run. Install it with: brew install gitleaks" >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml
